# Configuração da APLICAÇÃO. Preencha .env.local somente na sua máquina/Vercel.
# URL canônica exata usada na validação de origem de Server Actions.
APP_URL=
# Projeto Supabase https://<project-ref>.supabase.co; nunca uma URL arbitrária.
SUPABASE_URL=
# Chave publishable/anon, nunca service_role. Não há SDK Auth no navegador.
SUPABASE_PUBLISHABLE_KEY=
# PostgreSQL da aplicação (pooler). Credencial somente server-side.
DATABASE_URL=
# Conexão direta/sessão para Prisma migrations, executadas pelo responsável.
DIRECT_URL=
# Chave Pixabay somente para preparação local das fotos.
PIXABAY_API_KEY=
# Segredos administrativos para scripts humanos NÃO devem ficar neste arquivo.
# Consulte scripts/human/ e APLICAR.md; nunca forneça esses segredos ao agente.
